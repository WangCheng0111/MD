<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MD.Controls.EdgeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AddTabButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#99000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="AddRoot">
                            <Grid x:Name="AddBackground"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Margin="4" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ZIndex=1：选中标签的外翻角会向下溢出 1px 到内容区第一行（与分割线衔接），
             需盖在 ContentHost 背景之上，否则会被半透明白背景冲淡 -->
        <Grid x:Name="StripRoot" Grid.Row="0" Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter x:Name="HeaderPresenter" />

            <StackPanel x:Name="TabsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom" />

            <Button x:Name="AddButton"
                    Grid.Column="2"
                    Style="{StaticResource AddTabButtonStyle}"
                    Content="&#xE710;"
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,0"
                    Click="AddButton_Click" />

            <!-- 标签右侧的空白拖拽区（标题栏拖动由窗口 Caption 区域接管） -->
            <Grid x:Name="DragArea"
                  Grid.Column="3"
                  MinWidth="48"
                  Background="Transparent" />
        </Grid>

        <ContentPresenter x:Name="ContentHost"
                          Grid.Row="1"
                          Background="#F2FFFFFF" />

        <!-- 标题栏底部 1px 分割线：画在内容区第一行（在金刚键/标签底色下沿之外，不会被覆盖），
             选中标签处由代码挖洞 -->
        <Canvas x:Name="BottomDividerCanvas"
                Grid.Row="1"
                Height="1"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <Border x:Name="BottomDividerLeft"
                    Canvas.Top="0"
                    Height="1"
                    Background="#1A000000" />
            <Border x:Name="BottomDividerRight"
                    Canvas.Top="0"
                    Height="1"
                    Background="#1A000000" />
        </Canvas>
    </Grid>
</UserControl>
