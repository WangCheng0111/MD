<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MD.Controls.EdgeTabItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CloseRoot"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Height="40"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost">
        <Border x:Name="StateBackground"
                CornerRadius="12,12,0,0"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- 相邻未选中标签之间的分隔线（由父级控制显隐） -->
        <Border x:Name="Separator"
                Width="1" Height="16"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="#1A000000"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <Border x:Name="Body"
                Background="Transparent"
                CornerRadius="12,12,0,0"
                Padding="10,3,4,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="IconBox"
                         MaxWidth="16" MaxHeight="16"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed">
                    <ContentControl x:Name="IconControl"
                                    IsTabStop="False"
                                    Foreground="#99000000" />
                </Viewbox>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#99000000"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderBoldPlaceholder"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Style="{StaticResource TabCloseButtonStyle}"
                        Content="&#xE711;"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border x:Name="Outline"
                BorderThickness="1,1,1,0"
                CornerRadius="12,12,0,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False" />

        <!-- 最右侧标签与"+"之间的分隔线（由父级控制显隐） -->
        <Border x:Name="SeparatorRight"
                Width="1" Height="16"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#1A000000"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- 底部外翻的"八"字凹角：伸出标签主体外，与相邻标签咬合 -->
        <Path x:Name="LeftFlare"
              IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Fill="Transparent" />
        <Path x:Name="RightFlare"
              IsHitTestVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Fill="Transparent" />
        <Path x:Name="LeftFlareOutline"
              IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <Path x:Name="RightFlareOutline"
              IsHitTestVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
